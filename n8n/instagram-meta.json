        0,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "Token de verificación no configurado o inválido",
        "options": {
          "responseCode": 403
        }
      },
      "id": "61456f2d-8d7f-4b3d-95c4-9b7d57189e86",
      "name": "Responder 403 Prohibido",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        0,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "// Recupera el aviso ORIGINAL de Meta (n8n lo deja codificado en binary.data\n// por la opción Raw Body) y la firma, para reenviarlos intactos al dashboard.\n// La firma X-Hub-Signature-256 la valida el dashboard (/api/bandeja/procesar-evento)\n// en tiempo constante y fallando cerrado; aquí no se usa crypto (n8n lo bloquea).\nconst item = $input.first();\nconst b64 = (item.binary && item.binary.data && item.binary.data.data) || '';\nconst rawBody = b64 ? Buffer.from(b64, 'base64').toString('utf8') : '';\nconst headers = item.json.headers || {};\nconst signatureHeader = headers['x-hub-signature-256'] || '';\nreturn [{ json: { listo: Boolean(rawBody && signatureHeader), rawBody, signatureHeader } }];"
      },
      "id": "15f3d298-3775-4091-828d-7ae73a706257",
      "name": "Preparar reenvío al dashboard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -416,
        304
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.listo }}",
              "value2": true
            }
          ]
        }
      },
      "id": "2bd08437-962d-4240-9664-82879909952e",
      "name": "¿Firma Válida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
